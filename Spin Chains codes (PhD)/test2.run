#!/bin/bash -l


#SBATCH --nodes 1
#SBATCH --ntasks 1
#SBATCH --cpus-per-task 3
#SBATCH --mem 20048
#SBATCH --time 72:0:0


sleep 10

echo "hello from `hostname`"

module load gcc python 

source ~/myenv/bin/activate

export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK


srun python3 /home/amsharma/DMRGparallel/groundstate/python15.py

sleep 10